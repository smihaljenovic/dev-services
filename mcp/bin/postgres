#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1091
source "$(dirname "$0")/_env.sh"
cd "$ROOT"

CONN="${POSTGRES_URL:-postgresql://root:root@localhost:5432/postgres}"
exec "$NODE" "$ROOT/node_modules/@modelcontextprotocol/server-postgres/dist/index.js" "$CONN"
